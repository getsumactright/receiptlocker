---
// Social profile icons. A profile with no URL shows dimmed and unlinked ("coming soon").
import { SOCIAL } from '../config';

const ICONS: Record<string, string> = {
  Instagram: '<rect x="3" y="3" width="18" height="18" rx="5" fill="none" stroke="currentColor" stroke-width="1.8"/><circle cx="12" cy="12" r="4.2" fill="none" stroke="currentColor" stroke-width="1.8"/><circle cx="17.3" cy="6.7" r="1.15" fill="currentColor"/>',
  TikTok: '<path fill="currentColor" d="M16.6 2h-3.4v13.6a2.9 2.9 0 1 1-2.9-2.9c.3 0 .6 0 .9.1V9.3a6.3 6.3 0 1 0 5.4 6.3V8.7a7.9 7.9 0 0 0 4.4 1.4V6.7a4.4 4.4 0 0 1-4.4-4.4z"/>',
};
---
<ul class="social" aria-label="ReceiptLocker on social media">
  {SOCIAL.map(({ name, href }) => (
    <li>
      {href
        ? <a href={href} rel="noopener me" target="_blank" aria-label={`${name} (opens in a new tab)`}><svg viewBox="0 0 24 24" width="22" height="22" aria-hidden="true" set:html={ICONS[name]} /></a>
        : <span class="soon" title={`${name} — coming soon`} aria-label={`${name}, coming soon`} role="img"><svg viewBox="0 0 24 24" width="22" height="22" aria-hidden="true" set:html={ICONS[name]} /></span>}
    </li>
  ))}
</ul>
